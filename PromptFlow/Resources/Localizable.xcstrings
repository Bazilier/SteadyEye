    "demo.script.content" : {
      "comment" : "Body text of the seeded demo script created on first launch. Plays through the WBW prompter to demonstrate the eye-contact mechanic. Translate naturally; the second-person closing invites the user to create their own script.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi. I'm reading a script right now, but my eyes stay on the camera. Words appear right under the lens, one at a time. Natural eye contact. Try it yourself — create your own script."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola. Estoy leyendo un guion ahora mismo, pero mis ojos se quedan en la cámara. Las palabras aparecen justo debajo del lente, una a la vez. Contacto visual natural. Pruébalo tú mismo — crea tu propio guion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá. Estou lendo um roteiro agora, mas meus olhos ficam na câmera. As palavras aparecem logo abaixo da lente, uma de cada vez. Contato visual natural. Experimente você mesmo — crie seu próprio roteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет. Я читаю скрипт прямо сейчас, но мои глаза остаются на камере. Текст появляется прямо под объективом, по одному слову. Получается естественный визуальный контакт. Попробуй сам — создай свой скрипт."
          }
        }
      }
    },
    "demo.script.title" : {
      "comment" : "Title of the seeded demo script created on first launch.",
