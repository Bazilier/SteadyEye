    },
    "review.satisfaction.body" : {
      "comment" : "Body copy on the satisfaction prompt shown after the first Camera Roll save of a user-written script. Names both branches honestly: a rating if it went well, a message to the founder if it did not.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it went well, a quick review helps other creators find SteadyEye. If not, tell me and I'll fix it."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si salió bien, una reseña rápida ayuda a otros creadores a descubrir SteadyEye. Si no, cuéntame y lo soluciono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deu certo, uma avaliação rápida ajuda outros criadores a descobrir o SteadyEye. Se não, me conta que eu resolvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если всё получилось, короткий отзыв поможет другим авторам найти SteadyEye. Если нет — напиши мне, и я исправлю."
          }
        }
      }
    },
