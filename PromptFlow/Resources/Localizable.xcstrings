    "chat.pinned.feedback" : {
      "comment" : "Pinned message at the top of the chat when it is opened from the satisfaction prompt's No branch. Mirrors chat.welcome's voice and structure. 'Cyril' is a proper noun (rendered 'Кирилл' in Russian). 'SteadyEye' is the brand name and must not be translated. The 👋 emoji is intentional.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi 👋 I'm Cyril. I built SteadyEye.\n\nSorry that one didn't go well. Tell me what went wrong and I'll fix it — I read every message."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola 👋 Soy Cyril. Creé SteadyEye.\n\nLamento que no haya salido bien. Cuéntame qué pasó y lo soluciono — leo cada mensaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi 👋 Sou Cyril. Criei o SteadyEye.\n\nDesculpa, essa não deu certo. Me conta o que aconteceu que eu resolvo — leio cada mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет 👋 Я Кирилл. Я создал SteadyEye.\n\nЖаль, что не получилось. Расскажи, что пошло не так, и я исправлю — я читаю каждое сообщение."
          }
        }
      }
    },
