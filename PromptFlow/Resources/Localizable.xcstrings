    },
    "script.charCount" : {
      "comment" : "Character count display in the editor stats bar. %1$@ is the current character count, %2$@ is the maximum (currently 5000). Both are pre-formatted via Int.formatted() so they appear with locale-appropriate digit grouping (e.g. '5,000' in en, '5 000' in es-419/pt-BR/ru). The trailing word is an abbreviation of 'characters' — short to fit alongside the word count on a stacked two-row layout.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@ chars"
          }
        },
