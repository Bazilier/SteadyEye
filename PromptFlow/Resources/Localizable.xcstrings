      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye needs camera and microphone access to record your videos. You can enable them later in Settings if you change your mind."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye necesita acceso a la cámara y al micrófono para grabar tus videos. Puedes habilitarlos más tarde en Ajustes si cambias de opinión."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteadyEye precisa de acesso à câmera e ao microfone para gravar seus vídeos. Você pode habilitá-los depois em Ajustes se mudar de ideia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye нужен доступ к камере и микрофону, чтобы записывать видео. Вы можете включить их позже в Настройках, если передумаете."
          }
        }
      }
    },
    "SteadyEye shows your text right under the camera lens — so your eyes never leave the camera." : {
      "comment" : "A description of how SteadyEye works.",
