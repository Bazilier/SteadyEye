          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-скрипт"
          }
        }
      }
    },
    "demo_nudge.body" : {
      "comment" : "Body of the alert shown once after the user records their first demo video, encouraging them to start a free trial to record their own scripts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recording demo videos is free. To record your own scripts, start a free 7-day trial."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabar videos demo es gratis. Para grabar tus propios guiones, comienza una prueba gratuita de 7 días."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravar vídeos demo é grátis. Para gravar seus próprios roteiros, comece um teste grátis de 7 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись демо-видео бесплатна. Чтобы записывать свои скрипты, начни 7-дневный бесплатный пробный период."
          }
        }
      }
    },
