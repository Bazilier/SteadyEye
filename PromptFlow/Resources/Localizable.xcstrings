    "demo.script.content" : {
      "comment" : "Body text of the seeded demo script created on first launch. The example uses copywriting jargon (Headline, Pain points, Benefits, CTA) that should be translated naturally for marketing content.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi. I'm reading a script right now. My eyes stay on the camera. The text appears right under the lens, one word at a time. Pretty cool, right?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola. Estoy leyendo un guion ahora mismo. Mis ojos siguen en la cámara. El texto aparece justo debajo del lente, una palabra a la vez. Genial, ¿verdad?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi. Estou lendo um roteiro agora mesmo. Meus olhos ficam na câmera. O texto aparece bem embaixo da lente, uma palavra de cada vez. Legal, né?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У твоего лендинга 5 частей — и большинство ставит пропорции НЕПРАВИЛЬНО!! Вот формула: Заголовок (5% страницы). Боли — 15%. Выгоды = 20%. Продукт — 40%. CTA — 20%. Большинство фаундеров отдают 80% продукту и забивают на боли и выгоды… Поэтому никто не конвертится!!!"
          }
        }
      }
    },
    "demo.script.title" : {
      "comment" : "Title of the seeded demo script created on first launch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try it now"
          }
        },
        "es-419" : {
