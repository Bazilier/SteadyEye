    "scripts.recording.tip.body" : {
      "comment" : "Body text for the first-run tip overlay shown on the recording screen, explaining the long-press-and-drag gesture for vertical text positioning. Shown once per install when a non-demo script is opened in RecordingView.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the text and drag up or down to align it with your camera lens. The closer to the lens, the more natural your eye contact."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado el texto y arrástralo arriba o abajo para alinearlo con el lente de tu cámara. Cuanto más cerca del lente, más natural será tu contacto visual."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione o texto e arraste para cima ou para baixo para alinhar com a lente da câmera. Quanto mais perto da lente, mais natural fica o contato visual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зажми текст и перетащи вверх или вниз, чтобы выровнять его под объективом камеры. Чем ближе к объективу, тем естественнее зрительный контакт."
          }
        }
      }
    },
