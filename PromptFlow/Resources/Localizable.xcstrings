    "settings.allowBluetoothMics.footer" : {
      "comment" : "Helper text below the Allow Bluetooth microphones toggle, explaining the audio-quality tradeoff and clarifying that wired/USB mics are unaffected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods and other Bluetooth headphones use telephony-grade audio (16kHz). Wired and USB microphones (DJI, Rode, Shure, etc.) always work automatically."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los AirPods y otros auriculares Bluetooth usan audio de calidad telefónica (16kHz). Los micrófonos con cable y USB (DJI, Rode, Shure, etc.) funcionan siempre automáticamente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods e outros fones Bluetooth usam áudio de qualidade telefônica (16kHz). Microfones com fio e USB (DJI, Rode, Shure, etc.) sempre funcionam automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPods и другие Bluetooth наушники используют телефонное качество звука (16kHz). Проводные и USB микрофоны (DJI, Rode, Shure и др.) всегда работают автоматически."
          }
        }
      }
