    "onboarding.sample.content" : {
      "comment" : "Ready-made sample script a new user records in onboarding when they have no topic yet. Read aloud on camera, first person; keep it short and natural.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! This is my first take with SteadyEye. The words appear right under the lens, so I can read and still look you in the eye. No notes, no looking down. Just me and the camera."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Esta es mi primera toma con SteadyEye. Las palabras aparecen justo debajo del lente, así que puedo leer y seguir mirándote a los ojos. Sin notas, sin mirar hacia abajo. Solo yo y la cámara."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi! Esta é a minha primeira gravação com o SteadyEye. As palavras aparecem logo abaixo da lente, então posso ler e continuar olhando nos seus olhos. Sem anotações, sem olhar para baixo. Só eu e a câmera."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет! Это мой первый дубль в SteadyEye. Слова появляются прямо под объективом, поэтому я читаю и при этом смотрю вам в глаза. Без шпаргалок и взглядов вниз. Только я и камера."
          }
        }
      }
    },
