    "chat.welcome" : {
      "comment" : "Pinned welcome message at the top of the chat from the founder. Two short paragraphs separated by a blank line. 'Cyril' is a proper noun (rendered 'Кирилл' in Russian). 'SteadyEye' is the brand name and must not be translated. The 👋 emoji is intentional.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi 👋 I'm Cyril. I built SteadyEye.\n\nMessage me directly — I read every message."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola 👋 Soy Cyril. Creé SteadyEye.\n\nEscríbeme directamente — leo cada mensaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi 👋 Sou Cyril. Criei o SteadyEye.\n\nEscreva diretamente — leio cada mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет 👋 Я Кирилл. Я создал SteadyEye.\n\nНапиши мне напрямую — я читаю каждое сообщение."
          }
        }
      }
    },
