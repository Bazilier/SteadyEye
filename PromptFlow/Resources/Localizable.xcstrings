    "editor.optimize_tip.body" : {
      "comment" : "Body of the tip shown the first time the editor holds the user's own text.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimize prepares your text for reading aloud: numbers become words, abbreviations are spelled out, long sentences get shorter."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizar prepara tu texto para leerlo en voz alta: los números se vuelven palabras, las abreviaturas se escriben completas y las frases largas se acortan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otimizar prepara seu texto para ler em voz alta: números viram palavras, abreviações são escritas por extenso e frases longas ficam mais curtas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизация подготовит текст для чтения вслух: цифры станут словами, сокращения раскроются, длинные фразы станут короче."
          }
        }
      }
    },
