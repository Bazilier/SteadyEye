    "NSCameraUsageDescription" : {
      "comment" : "Permission prompt shown when SteadyEye first requests camera access. Apple App Store requires this to be localized to match the App Store listing locale.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye uses the camera so you can record yourself while reading your script."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye usa la cámara para que puedas grabarte mientras lees tu guion."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteadyEye usa a câmera para você se gravar enquanto lê seu roteiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye использует камеру, чтобы ты мог записывать себя, читая скрипт."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Permission prompt shown when SteadyEye first requests microphone access. Apple App Store requires this to be localized.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye uses the microphone to record audio while you film your video."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye usa el micrófono para grabar audio mientras filmas tu video."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteadyEye usa o microfone para gravar áudio enquanto você grava seu vídeo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye использует микрофон, чтобы записывать звук во время съёмки."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Permission prompt shown when SteadyEye saves a recorded video to the user's Photos library. Apple App Store requires this to be localized.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye saves your recorded videos to your Photo Library."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye guarda los videos que grabas en tu fototeca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SteadyEye salva seus vídeos gravados na sua biblioteca de Fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SteadyEye сохраняет записанные видео в твою медиатеку «Фото»."
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "comment" : "Permission prompt shown when SteadyEye requests App Tracking Transparency authorization. Apple App Store requires this to be localized.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow SteadyEye to measure how ads help new creators find our app. Your data stays anonymous."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que SteadyEye mida qué anuncios ayudan a nuevos creadores a encontrar la app. Tus datos siguen siendo anónimos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o SteadyEye veja quais anúncios trazem novos criadores ao app. Seus dados permanecem anônimos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это поможет показывать тебе более релевантную рекламу."
          }
        }
      }
    }
  },
  "version" : "1.0"
